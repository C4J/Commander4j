<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
	id="WebApp_ID" version="6.0" metadata-complete="false">
	<display-name>c4j_commander4j_web</display-name>
	<description>Commander4j mobile web client (REST + JS)</description>

	<welcome-file-list>
		<welcome-file>index.html</welcome-file>
	</welcome-file-list>

	<!-- API servlets are registered with @WebServlet in com.commander4j.web.api -->

	<listener>
		<listener-class>com.commander4j.web.listener.AppServletContextListener</listener-class>
	</listener>
	<listener>
		<listener-class>com.commander4j.web.listener.AppServletSessionListener</listener-class>
	</listener>

	<session-config>
		<session-timeout>60</session-timeout>
	</session-config>

	<filter>
		<filter-name>CanonicalUrlFilter</filter-name>
		<filter-class>com.commander4j.web.filter.CanonicalUrlFilter</filter-class>
		<init-param>
			<param-name>mapLocation</param-name>
			<param-value>/WEB-INF/canon-paths.properties</param-value>
		</init-param>
	</filter>
	<filter-mapping>
		<filter-name>CanonicalUrlFilter</filter-name>
		<url-pattern>/*</url-pattern>
	</filter-mapping>

	<filter>
		<filter-name>NoCacheFilter</filter-name>
		<filter-class>com.commander4j.web.filter.NoCacheFilter</filter-class>
	</filter>
	<filter-mapping>
		<filter-name>NoCacheFilter</filter-name>
		<url-pattern>/*</url-pattern>
	</filter-mapping>
</web-app>
